# ── LLM Provider (pick ONE) ─────────────────────────────────
# The agent auto-detects which key is set and uses that provider.
# Designed for Claude, but works with any of the following:

# Option 1: Anthropic (Claude) — recommended
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Option 2: OpenAI (GPT-4o)
# Get a key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-api-key-here

# Option 3: Google (Gemini)
# Get a key at: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-api-key-here

# Option 4: xAI (Grok)
# Get a key at: https://console.x.ai/
# XAI_API_KEY=your-api-key-here

# ── Webhook Config ───────────────────────────────────────────
# Passphrase to authenticate TradingView alerts
# WEBHOOK_PASSPHRASE=change-this-to-something-secret

# Server port (default 8080, avoid 5000 on macOS — AirPlay uses it)
# WEBHOOK_PORT=8080

# Set to "true" to have Claude analyze each incoming alert
# WEBHOOK_AI_ANALYSIS=false

# ── Optional ────────────────────────────────────────────────

# Override the default model:
# MODEL=claude-sonnet-4-20250514
# MODEL=gpt-4o
# MODEL=gemini-2.0-flash
# MODEL=grok-3-mini-fast

# Nasdaq Data Link API key (for fundamentals/economic data)
# NASDAQ_API_KEY=your-nasdaq-key-here

# CoinMarketCap API key (for additional crypto data)
# CMC_API_KEY=your-coinmarketcap-key-here
